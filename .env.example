# Repo Watch environment variables

# --- Required (production via Vercel Connect) ---
CONNECTOR_SLACK=slack/your-slack-connector
CONNECTOR_GITHUB=github/your-github-connector
DIGEST_CHANNEL_ID=slack:C0BBBSHSLFQ
REDIS_URL=redis://default:password@host:6379
CRON_SECRET=replace-with-openssl-rand-base64-32
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret

# --- Optional ---
BOT_USER_NAME=repo-watch
AGENT_MODEL=anthropic/claude-sonnet-4.6
DIGEST_MODEL=anthropic/claude-haiku-4.5

# --- Local development fallback (skip Connect) ---
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_SIGNING_SECRET=your-signing-secret
# GITHUB_TOKEN=ghp_your-personal-access-token

# --- Vercel OIDC (pulled by `vercel env pull`) ---
# VERCEL_OIDC_TOKEN=...
